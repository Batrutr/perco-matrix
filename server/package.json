{
    "name": "@perco/server",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "main": "src/index.ts",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc -p tsconfig.json --noEmit && esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/index.js --external:fastify --external:@fastify/* --external:undici --external:zod --external:mysql2",
        "start": "node dist/index.js",
        "seed": "tsx src/seed.ts",
        "test": "node --import tsx --test src/*.test.ts",
        "typecheck": "tsc -p tsconfig.json --noEmit"
    },
    "dependencies": {
        "@fastify/compress": "^8.0.1",
        "@fastify/cookie": "^11.0.2",
        "@fastify/helmet": "^13.0.1",
        "@fastify/rate-limit": "^10.2.2",
        "@fastify/static": "^9.1.3",
        "@perco/shared": "*",
        "fastify": "^5.2.1",
        "mysql2": "^3.12.0",
        "undici": "^7.3.0",
        "zod": "^3.24.1"
    },
    "devDependencies": {
        "@types/node": "^24.0.0",
        "esbuild": "^0.25.0",
        "tsx": "^4.19.2",
        "typescript": "^5.7.3"
    }
}
