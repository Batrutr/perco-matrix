# --- Подключение к PERCo ---
# Хост без схемы или с ней, напр. https://192.168.1.10 или 192.168.1.10
PERCO_HOST=https://perco.example.local
PERCO_LOGIN=admin
PERCO_PASSWORD=changeme

# --- Сервер приложения ---
PORT=3000
HOST=0.0.0.0

# Путь к файлу БД SQLite
DB_PATH=./data/perco.sqlite

# Путь к собранной статике клиента (необязательно). Пусто = ../client/dist рядом с сервером.
STATIC_DIR=

# «Важные» шаблоны для закрепления слева одной кнопкой — по id или по имени,
# через запятую. Напр.: PINNED_TEMPLATES=310,Проходная,39094478
PINNED_TEMPLATES=

# Аббревиатуры графиков для ячеек матрицы: JSON-объект «имя графика → буква».
# Имена, которых тут нет, сокращаются до первой буквы. Пусто = всё по первой букве.
# Имена могут содержать двоеточие (JSON это допускает). Пример:
# SCHEDULE_ABBR={"Рабочий день":"Р","Будни до 18:00":"Б","Круглосуточно":"К"}
SCHEDULE_ABBR=

# Лимит одновременных запросов к PERCo при загрузке деталей шаблонов
PERCO_CONCURRENCY=8

# Проверять TLS-сертификат PERCo. false — ТОЛЬКО для self-signed в доверенной сети!
PERCO_TLS_REJECT_UNAUTHORIZED=true

# --- БД PERCo (MariaDB) для счётчика сотрудников на шаблон ---
# Необязательно: если PERCO_DB_HOST пуст — счётчик сотрудников будет «–».
# Рекомендуется отдельный пользователь БД с правом только на SELECT.
PERCO_DB_HOST=
PERCO_DB_PORT=3306
PERCO_DB_NAME=
PERCO_DB_USER=
PERCO_DB_PASSWORD=

# --- Защита веб-интерфейса (опционально) ---
# Если задан — интерфейс закрыт паролем. Пусто = без защиты.
APP_PASSWORD=

# Секрет для подписи cookie сессии. Если пусто — выводится из APP_PASSWORD
# (сессии переживают рестарт). Задайте для нескольких инстансов.
APP_COOKIE_SECRET=
